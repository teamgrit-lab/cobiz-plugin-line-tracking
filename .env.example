# ROS / DDS
ROS_DOMAIN_ID=0
TEAMGRIT_DDS_DIR=/opt/ros/teamgrit/dds

# 모델 / 백엔드
# 기본 R50: r50-fp16-640x360 + pytorch, CUDA FP16, 640x360 입력
# Swin-L TensorRT: swin-l-aspect-224x384-fp16 + tensorrt
# 로컬 미세조정 R50: r50-finetuned-fp16-640x360 + pytorch
# MODEL_ID는 /models/<내보낸 모델>/best 경로로 지정한다.
# 미세조정 모델의 task-drive는 checkpoint-manifest.json의 SHA-256이 필요하다.
SWIN_L_PROFILE=r50-fp16-640x360
SWIN_L_MODEL_ID=
SWIN_L_MODEL_REVISION=
SWIN_L_CHECKPOINT_SHA256=
SWIN_L_DEVICE=cuda
SWIN_L_BACKEND=pytorch
SWIN_L_ALLOW_BACKEND_FALLBACK=false
# Fixed-shape native R50 CUDA replay; CUDA/PyTorch R50 profiles only.
SWIN_L_CUDA_GRAPH=false
# Path/metrics only; 0 = every control tick. Jetson motion profile: 5 Hz.
SWIN_L_TELEMETRY_HZ=0.0
# Isolate CUDA/HTTP/geometry from the live ROS sensor/control interpreter.
SWIN_L_INFERENCE_PROCESS=false

# 0=차도+인도, 1=차도, 2=인도
# 0은 차도·인도 라벨의 합집합이며 배경 라벨은 제외한다.
SWIN_L_PATH_MASK_CLASS=0

# Docker 이미지 / 모델 저장 경로
# Jetson 기본 이미지는 미리 빌드하며, TensorRT 사용 시 엔진도 별도로 빌드한다.
# SWIN_L_ENGINE_DIR은 컨테이너의 /models에 마운트된다.
SWIN_L_BASE_IMAGE=cobiz:jetson-swin-l-l4t-r36.5.0
SWIN_L_TORCHVISION_INDEX_URL=https://pypi.jetson-ai-lab.io/jp6/cu126
SWIN_L_TORCHVISION_VERSION=0.23.0
SWIN_L_TORCH_TENSORRT_VERSION=2.8.0+cu126
SWIN_L_DEBUG_IMAGE=cobiz-plugin-line-tracking-swin-l-debug
SWIN_L_MODEL_CACHE_DIR=./.cache/huggingface
SWIN_L_ENGINE_DIR=./models

# Swin-L TensorRT 전용 (PyTorch R50·전면 커넥톰 추론에서는 사용하지 않음)
SWIN_L_PREPARED_CHECKPOINT_DIR=./models/swin-l-checkpoint
SWIN_L_TRT_ENGINE=/models/swin-l-224x384-fp16.plan
SWIN_L_TRT_MANIFEST=/models/swin-l-224x384-fp16.plan.json
SWIN_L_TRT_AUTO_BUILD=false

# 전면 카메라 커넥톰 모델 (선택 사용)
# Jetson의 ~/dev/dangjin-a2/cobiz-plugin-line-tracking/에서 Compose를 실행하는 기준.
# 모델 패키지 전체(front_model.pt, flyvis_encoder.pt, model.json 등)를 아래 폴더에 복사한다.
# 사용하려면 COMPOSE_FILE의 주석을 해제한다. 기존 R50 실행에서는 주석을 유지한다.
# 다른 Compose 파일을 이미 사용 중이면 기존 구성을 확인한 뒤 전면 모델 override를 추가한다.
# COMPOSE_FILE=docker-compose.yml:docker-compose.front-connectome.yml
CONNECTUM_FRONT_MODEL_DIR=./models/front-road-v2-road-only-20261027
# 아래 해시는 전면 v2의 front_model.pt 기준이다. 모델 교체 시 경로와 해시를 함께 변경한다.
# 확인: sha256sum ./models/<모델 폴더>/front_model.pt
# model.json의 weights_sha256["front_model.pt"]와도 일치해야 한다.
CONNECTUM_FRONT_SHA256=43cddf61ba3781b7d241f274d9a6259b1409c0541d650dd3d31aa91b35cf6f88
LINE_TRACKING_FRONT_CONNECTOME_TIMEOUT_SEC=1.5
# 아래 입력 최대 나이는 전면 모델과 기존 광류 커넥톰 서비스가 공유한다.
LINE_TRACKING_CONNECTOME_MAX_AGE_SEC=1.5
# Cobiz selected_mask=1: 전면 커넥톰 / selected_mask=2: 기존 SWIN_L_PROFILE 모델·제어기.
# 두 모델은 시작 후 작업별로 전환한다. 혼합 모드 0은 이 구성에서 지원하지 않는다.
# 전면 override에서 작업의 selected_mask가 생략되면 Road(1)를 기본으로 사용한다.
# 전면 override는 local planner와 inference process 비활성을 지정한다.
# 기존 motion 설정은 Sidewalk에서만 적용하며 Road는 학습된 속도·회전을 사용한다.
# 추론 URL(http://127.0.0.1:8092/v1/front-road)과 모델 해시는 Compose가 노드에 전달한다.
# SWIN_L_BACKEND=pytorch와 SWIN_L_TRT_AUTO_BUILD=false를 유지한다.
# 설치·빌드·모델 교체 절차: docs/front-connectome.md

# 기존 차도 광류 커넥톰 경로 탐색 (전면 모델 서비스와 별개, 선택 사용)
# docker-compose.connectome.yml을 추가하면 PATH_PLANNER=connectome과 아래 URL이 지정된다.
# 기본 local 경로 탐색은 외부 광류 서비스를 사용하지 않는다. 자세한 내용: docs/connectome.md
LINE_TRACKING_PATH_PLANNER=local
# 직접 Python 실행용 URL. Compose override에서는 같은 주소를 고정 지정한다.
LINE_TRACKING_CONNECTOME_URL=http://127.0.0.1:8091/v1/plan
LINE_TRACKING_CONNECTOME_TIMEOUT_SEC=0.8
CONNECTOME_MODEL_DIR=./models
CONNECTOME_BUNDLE=/models/flyvis_encoder.pt
# Required by docker-compose.connectome.yml; hash the verified pretrained bundle.
CONNECTOME_BUNDLE_SHA256=
CONNECTOME_DEVICE=cuda
CONNECTOME_CUDA_GRAPH=false
CONNECTOME_CPU_SHARES=1024

# CPU 스레드 / 실행 우선순위
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
# CPU 경쟁 시 주행 컨테이너의 상대 가중치.
LINE_TRACKING_CPU_SHARES=1024

# 카메라 / 출력 토픽
# 카메라 원본 해상도와 별개로 모델 출력·Path 계산은 640x360을 사용한다.
# 전면 커넥톰 사용 시 IMAGE_TOPIC을 /a2/front_camera/res_360p/image_raw로 변경한다.
# 전면 모델 내부 입력은 480x270이며, 토픽의 360p는 전면 영상 해상도를 뜻한다.
SWIN_L_EVALUATION_HEIGHT=360
SWIN_L_EVALUATION_WIDTH=640
SWIN_L_IMAGE_TOPIC=/a2/front_camera/res_720p/image_raw
SWIN_L_LOCAL_PATH_TOPIC=/line_tracking/swin_l/local_path
SWIN_L_METRICS_TOPIC=/line_tracking/swin_l/metrics
SWIN_L_PATH_FRAME_ID=base_link
SWIN_L_INPUT_RELIABILITY=best_effort

# Livox 장착 보정 / 센서 토픽
# 빈 CameraInfo 토픽은 주행 카메라의 네임스페이스를 따른다.
# livox-a2-front는 A2 MID360의 측정된 고정 보정을 사용한다.
# 다른 장착 구성은 tf 프로필 또는 측정한 변환행렬을 지정한다.
# 행렬은 target-from-source 4x4, 행 우선, 쉼표 구분이다.
# 빈 행렬은 선택한 프로필의 보정값을 사용하며 tf 프로필에서는 TF를 조회한다.
# 기울어진 livox_frame에 임의의 단위행렬이나 Unitree JT128 보정을 쓰지 않는다.
SWIN_L_LIDAR_TOPIC=/livox/lidar
SWIN_L_LIDAR_IMU_TOPIC=/livox/imu
SWIN_L_CAMERA_INFO_TOPIC=
SWIN_L_LIDAR_FRAME_ID=livox_frame
SWIN_L_LIDAR_CALIBRATION_PROFILE=livox-a2-front
SWIN_L_LIDAR_TO_BASE_TRANSFORM=
SWIN_L_BASE_TO_CAMERA_TRANSFORM=

# Livox 장애물 감지 범위
# base_link 기준 높이 ±0.20m, 수평 반경 1.5m, +x축 기준 ±95도(총 190도).
# IMU 단위 auto는 Livox SDK2의 g 및 표준 ROS의 m/s²를 구분한다.
LIDAR_OBSTACLE_HEIGHT_REFERENCE=base_link
LIDAR_OBSTACLE_MIN_HEIGHT_M=-0.2
LIDAR_OBSTACLE_MAX_HEIGHT_M=0.2
LIDAR_OBSTACLE_HORIZONTAL_RANGE_M=1.5
LIDAR_OBSTACLE_FOV_DEG=190.0
LIDAR_OBSTACLE_MAX_AGE_SEC=0.3
LIDAR_OBSTACLE_IMU_ACCEL_UNIT=auto

# 장애물 격자 / 로봇 외곽
# 격자 저장 범위 전체가 감지 범위는 아니며 위 거리·각도로 관측을 제한한다.
# 로봇 외곽과 자체 반사 제외 범위는 실제 장착물·보행 범위에 맞춰 보정한다.
LIDAR_OBSTACLE_FORWARD_M=6.0
LIDAR_OBSTACLE_REAR_M=1.0
LIDAR_OBSTACLE_HALF_WIDTH_M=2.0
LIDAR_OBSTACLE_RESOLUTION_M=0.1
LIDAR_OBSTACLE_FRONT_M=0.5
LIDAR_OBSTACLE_BACK_M=0.45
LIDAR_OBSTACLE_ROBOT_HALF_WIDTH_M=0.3
LIDAR_OBSTACLE_MARGIN_M=0.15
LIDAR_OBSTACLE_SELF_FRONT_M=0.3
LIDAR_OBSTACLE_SELF_BACK_M=0.3
LIDAR_OBSTACLE_SELF_HALF_WIDTH_M=0.16
LIDAR_OBSTACLE_LIDAR_TO_GROUND_M=0.4
LIDAR_OBSTACLE_INFLATION_M=2.0

# 로컬 장애물 회피
# ENABLED: true=LiDAR 회피 사용, false=카메라 Path로만 주행.
# odom 없이 10Hz LiDAR마다 목표를 갱신하고 20Hz 제어에서 부드럽게 변경한다.
# PREFERENCE의 right/left는 로봇 기준 우측/좌측이며 분기 선택과 별개다.
# 설정 변경은 프로세스 재시작 또는 Compose 컨테이너 재생성 후 적용된다.
LINE_TRACKING_AVOIDANCE_ENABLED=false

LINE_TRACKING_AVOIDANCE_PREFERENCE=right
LINE_TRACKING_AVOIDANCE_CONTROL_HZ=20.0
LINE_TRACKING_AVOIDANCE_MAX_LATERAL_MPS=0.15
LINE_TRACKING_AVOIDANCE_MAX_FORWARD_MPS=0.2
LINE_TRACKING_AVOIDANCE_MAX_ACCEL_MPS2=0.3
LINE_TRACKING_AVOIDANCE_PREDICTION_SEC=3.0
LINE_TRACKING_AVOIDANCE_MAX_PATH_AGE_SEC=2.0
LINE_TRACKING_AVOIDANCE_RETURN_GAIN=0.5
LINE_TRACKING_AVOIDANCE_BRAKE_MPS2=0.5
LINE_TRACKING_AVOIDANCE_UNTRACKED_CLOSING_MPS=1.0
LINE_TRACKING_AVOIDANCE_SIDE_HOLD_SEC=1.0

# Road 사람·차량 반대쪽 횡이동: docker-compose.road-objects.yml을 마지막에 추가.
# tools/prepare_road_object_model.py로 models/road-objects-mobilenet-fpn.pth 준비.
# 모델 가중치와 설정을 준비한 뒤 활성화하며 자동 다운로드하지 않는다.
# 아래 활성화·가중치 경로·해시 3개는 직접 Python 실행용이다.
# Compose 사용 시 이 3개는 road-objects override의 고정값을 사용한다.
LINE_TRACKING_ROAD_OBJECTS_ENABLED=false
LINE_TRACKING_ROAD_OBJECT_WEIGHTS=/models/road-objects-mobilenet-fpn.pth
LINE_TRACKING_ROAD_OBJECT_SHA256=907ea3f91ff92242bc1baea8049276a3e76bca48ce7560bd268cc029f37977b5
LINE_TRACKING_ROAD_OBJECT_MIN_LATERAL_MPS=0.3
LINE_TRACKING_ROAD_OBJECT_MAX_LATERAL_MPS=0.8

# AprilTag 검출기
# 다른 검출기가 같은 토픽에 발행 중이면 컨테이너 내부 검출기는 끈다.
# DEBUG 검출기는 actual-activate 검출기 없이 단독 디버깅할 때만 켠다.
SWIN_L_APRILTAG_DETECTOR_ENABLED=true
SWIN_L_DEBUG_APRILTAG_DETECTOR_ENABLED=false

# AprilTag 카메라 / 검출 설정
# 빈 값이면 주행 카메라와 해당 camera_info 토픽을 사용한다.
SWIN_L_APRILTAG_IMAGE_TOPIC=
SWIN_L_APRILTAG_CAMERA_INFO_TOPIC=
# 선택: 원격 카메라를 relay 한 곳에서 수신하고 원본 그대로 주행 노드와 공유.
# 검출기를 켜고 AprilTag 입력은 원격 원본, SWIN_L_IMAGE_TOPIC은 공유 출력으로 설정.
SWIN_L_SHARED_CAMERA_IMAGE_TOPIC=
SWIN_L_SHARED_CAMERA_INFO_TOPIC=
SWIN_L_APRILTAG_DETECTIONS_TOPIC=/detections
SWIN_L_APRILTAG_FAMILY=36h11
SWIN_L_APRILTAG_THREADS=2
SWIN_L_APRILTAG_DECIMATE=2.0
SWIN_L_APRILTAG_MAX_HAMMING=0
SWIN_L_APRILTAG_MAX_HZ=6.0

# AprilTag 확인 / 정지 대상 조건
# tag_approach가 인계할 거리·판정 여유·ID 조건을 만족하는 태그만 대상으로 한다.
# MAX_RANGE_M=0이면 거리 제한을 해제한다.
SWIN_L_APRILTAG_MAX_AGE_SEC=1.0
SWIN_L_APRILTAG_CONFIRM_WINDOW_SEC=1.0
SWIN_L_APRILTAG_CONFIRM_MIN_HITS=3
SWIN_L_APRILTAG_MAX_RANGE_M=3.0
SWIN_L_APRILTAG_MIN_DECISION_MARGIN=15
SWIN_L_APRILTAG_ALLOWED_IDS=0-30
SWIN_L_APRILTAG_TAG_SIZE_M=0.167

# 주행 설정
# MAX_TARGET_HEADING_DEG는 Path 목표각이다. 회전 속도는 ±0.18rad/s로 제한한다.
# 회전 요구가 커지면 전진 속도를 낮춘다.
LINE_TRACKING_SPORT_REQUEST_TOPIC=/api/sport/request
LINE_TRACKING_MAX_FORWARD_MPS=0.50
LINE_TRACKING_MAX_TARGET_HEADING_DEG=60.0

# 영상 경로 유실 시 직진 / 좌우 탐색 복구
# 연속 실패 1~2회는 마지막 전진 속도와 0 회전으로 복구하고 3회째는 정지한다.
# 정지 후 1초 대기하고 좌우 ±90도를 탐색하며 새 경로를 연속 확인한 뒤 재개한다.
# 회피가 꺼져 있을 때 사용하며, 회피가 켜져 있으면 Path 유실 시 정지한다.
LINE_TRACKING_PATH_LOSS_RECOVERY_ENABLED=true
LINE_TRACKING_PATH_RECOVERY_WAIT_SEC=1.0
# 마지막 유효 Path의 먼 구간이 꺾인 방향부터 탐색한다.
# 직선·작은 굽음(5도 미만)·오래된 Path 등 방향이 불명확할 때 아래 값을 사용한다.
# left: 왼쪽 +90도 → 오른쪽 -90도 → 원래 방향. right는 반대 순서.
LINE_TRACKING_PATH_RECOVERY_FIRST_DIRECTION=left
LINE_TRACKING_PATH_RECOVERY_YAW_RPS=0.18
LINE_TRACKING_PATH_RECOVERY_CONFIRM_FRAMES=2

# 자동 정지 조건: true=사용, false=해제
# 명시적 취소, 변환·추론·발행 오류, 종료, 입력 검증, 속도 제한은 항상 적용한다.
# 분기 경로 보호 및 활성화된 회피의 센서·Path·미관측·충돌 검사는 독립 적용한다.
# PATH_UNAVAILABLE은 즉시 정지, PATH_LOSS_LIMIT는 연속 5회 유실 시 정지한다.
# 두 항목이 false이고 회피도 꺼져 있으면 마지막 유효 전진·회전 명령을 유지한다.
LINE_TRACKING_STOP_ON_CAMERA_STALE=false
LINE_TRACKING_STOP_ON_INFERENCE_STALE=false
LINE_TRACKING_STOP_ON_CAMERA_TIMESTAMP_INVALID=false
LINE_TRACKING_STOP_ON_PATH_UNAVAILABLE=false
LINE_TRACKING_STOP_ON_PATH_LOSS_LIMIT=false
LINE_TRACKING_STOP_ON_LOW_CONFIDENCE=false
LINE_TRACKING_STOP_ON_LATERAL_TARGET=false
LINE_TRACKING_STOP_ON_APRILTAG=false
LINE_TRACKING_STOP_ON_STARTUP_HOLD=false
LINE_TRACKING_STOP_ON_STARTUP_UNREADY=false
LINE_TRACKING_STOP_ON_UNSAFE_TIMEOUT=false
LINE_TRACKING_STOP_ON_TASK_TIMEOUT=false

# 작업 이벤트 / 시간 설정
LINE_TRACKING_TASK_EVENT_TOPIC=/task_event
LINE_TRACKING_TASK_STATE_TOPIC=/task_state
LINE_TRACKING_DEFAULT_DURATION_SEC=500
LINE_TRACKING_MAX_DURATION_SEC=10000
LINE_TRACKING_UNSAFE_TIMEOUT_SEC=2

# 카메라 Path 추출 / 표시 / 장애물 검사 설정
# 전면 커넥톰의 속도·회전 출력은 모델이 결정한다. 아래 값은 모델 가중치를 변경하지 않는다.
# 카메라 ROI의 거리 매핑은 실제 장착 자세에 맞춰 별도로 보정한다.
# ROI: 아래 폭 84%, 위 폭 24%, 높이 55%(위쪽 y=45%).
# UNRESTRICTED는 경로 유효 비율 검사·시간 평활화만 해제한다.
# 추론 주기, 활성화된 자동 정지 및 회피 검사는 계속 적용한다.
SWIN_L_NEAR_DISTANCE_M=3.0
SWIN_L_FAR_DISTANCE_M=8.0
SWIN_L_GROUND_HALF_WIDTH_M=4.0
SWIN_L_SEARCH_HALF_WIDTH_M=3.5
SWIN_L_ROI_POLYGON=0.08,1.00,0.92,1.00,0.62,0.45,0.38,0.45
# Mode 1 only: widened trapezoid clear of the A2 handle. Mode 0/2 retain SWIN_L_ROI_POLYGON.
SWIN_L_ROAD_ROI_POLYGON=0.07,1.00,0.93,1.00,0.68,0.45,0.32,0.45
# Mode 1 only: exclude the A2 upper-right camera handle; empty disables it.
SWIN_L_ROAD_ROI_EXCLUSION_POLYGON=0.68,0.00,1.00,0.00,1.00,0.95,0.96,0.93,0.91,0.86,0.84,0.78,0.79,0.65,0.73,0.35
SWIN_L_PATH_POINTS=20
# Road-only spatial corridor continuity; 0 restores per-row midpoints.
LINE_TRACKING_ROAD_CORRIDOR_SMOOTHING_M=0.30
# Mode 1 only: soft distance cost from observed Building/ground contacts.
# Weight 0 disables it; distances use the existing ROI homography.
LINE_TRACKING_ROAD_BUILDING_COST_WEIGHT=2.0
LINE_TRACKING_ROAD_BUILDING_DISTANCE_M=2.0
SWIN_L_PATH_DURATION_SEC=1.50
SWIN_L_UNRESTRICTED_PATH_MODE=true

# 분기 선택
# left/right는 연결된 분기에서 해당 방향을 우선 선택하고 center는 기존 경로를 따른다.
# 차도 가장자리 선택이나 장애물 회피 방향 설정과는 별개다.
SWIN_L_BRANCH_PREFERENCE=right
SWIN_L_BRANCH_MIN_WIDTH_M=0.60
SWIN_L_BRANCH_MARGIN_M=0.10
SWIN_L_BRANCH_CONFIRM_FRAMES=2
SWIN_L_BRANCH_HOLD_SEC=1.50

# 추론 / 제어 발행 / 경로 평활화
# task-drive는 모델을 유지하고 수락된 작업 중에만 추론한다.
# ros2 디버그 모드는 작업 없이 계속 추론한다.
SWIN_L_INFERENCE_HZ=4.0
SWIN_L_OUTPUT_HZ=10.0
SWIN_L_SMOOTHING_TIME_CONSTANT_SEC=0.80
SWIN_L_MAX_LATERAL_UPDATE_M=0.35
SWIN_L_PATH_HOLD_SEC=0.90

# 오프라인 테스트
# 디렉터리는 호스트 사용자로 미리 생성한다.
# Compose 실행 전 SWIN_L_TEST_UID=$(id -u), SWIN_L_TEST_GID=$(id -g)를 export한다.
# 실행 컨테이너의 root 소유 캐시와 별도의 쓰기 가능한 캐시를 사용한다.
SWIN_L_ROSBAG_DIR=./rosbags
SWIN_L_TEST_RESULTS_DIR=./rosbag-results/swin-l-tests
SWIN_L_TEST_CACHE_DIR=./.cache/huggingface-tests

# Odom/IMU 이동 보정 (기존 광류 커넥톰 전용, 선택 사용)
# 전면 커넥톰 override에서는 MOTION_ENABLED=false로 고정한다.
# 빈 변환행렬은 TF의 base_link <- robot_center / dog_imu_link를 사용한다.
# 실제 장착 보정 없이 단위행렬을 지정하지 않는다.
LINE_TRACKING_MOTION_ENABLED=false
LINE_TRACKING_MOTION_ODOM_TOPIC=/dog_odom
LINE_TRACKING_MOTION_IMU_TOPIC=/dog_imu_raw
LINE_TRACKING_MOTION_BASE_FROM_CHILD_TRANSFORM=
LINE_TRACKING_MOTION_BASE_FROM_IMU_TRANSFORM=
LINE_TRACKING_MOTION_CONTROL_HZ=20.0
LINE_TRACKING_MOTION_SENSOR_MAX_AGE_SEC=0.20
LINE_TRACKING_MOTION_MAX_EXTRAPOLATION_SEC=0.05
LINE_TRACKING_MOTION_MAX_REFERENCE_AGE_SEC=1.0
LINE_TRACKING_MOTION_MAX_TRANSLATION_M=0.80
LINE_TRACKING_MOTION_MAX_ROTATION_DEG=25.0
LINE_TRACKING_MOTION_MAX_ACCEL_MPS2=0.30
LINE_TRACKING_MOTION_MAX_YAW_ACCEL_RPS2=0.50
LINE_TRACKING_MOTION_POINT_SPACING_M=0.10
