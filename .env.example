ROS_DOMAIN_ID=0
LINE_TRACKING_SPORT_REQUEST_TOPIC=/api/sport/request
INPUT_RELIABILITY=best_effort

# Surface-center local-path process. The camera may publish 720p; each model
# profile resizes the selected frame and produces a 640x360 score map.
SWIN_L_PROFILE=r50-fp16-640x360
# SWIN_L_PROFILE=swin-l-aspect-224x384-fp16
# R50 alternative: set BOTH SWIN_L_PROFILE=r50-fp16-640x360 and
# SWIN_L_BACKEND=pytorch. R50 uses its pinned Mapillary checkpoint and FP16 on
# CUDA, with a 640x360 resize target. It cannot use the Swin-L TensorRT engine.
# Path target: 0=road OR sidewalk, 1=road, 2=sidewalk (default).
# Target 0 combines semantic labels 1 and 2; semantic background 0 stays excluded.
SWIN_L_PATH_MASK_CLASS=0
SWIN_L_MODEL_ID=
SWIN_L_MODEL_REVISION=
SWIN_L_CHECKPOINT_SHA256=
# Local fine-tuned R50: replace the corresponding values in your .env with this
# complete model selection block. Place the exported best directory under
# ./models/r50-surface-v6/best; SWIN_L_ENGINE_DIR mounts ./models at /models.
# SWIN_L_PROFILE=r50-finetuned-fp16-640x360
# SWIN_L_MODEL_ID=/models/r50-surface-v6/best
# SWIN_L_MODEL_REVISION=
# SWIN_L_CHECKPOINT_SHA256=<paste the 64-character manifest SHA-256 below>
# SWIN_L_ENGINE_DIR=./models
# SWIN_L_DEVICE=cuda
# SWIN_L_BACKEND=pytorch
# SWIN_L_ALLOW_BACKEND_FALLBACK=false
# SWIN_L_TRT_AUTO_BUILD=false
# Obtain the pin on the host (copy only the first output field into .env):
# sha256sum ./models/r50-surface-v6/best/checkpoint-manifest.json
# task-drive requires a matching pin; debug may omit it. All local loads verify
# checkpoint-manifest.json and its model/config/processor artifact hashes.
# For the Jetson debug container use cuda. Build this local base image once on
# the Jetson host with jetson-containers before starting Compose:
# PYTORCH_VERSION=2.8 CUDA_VERSION=12.6 jetson-containers build \
#   --base=cobiz:jetson --name=cobiz:jetson-swin-l \
#   --skip-packages=ffmpeg,opencv,ros pytorch:2.8
SWIN_L_DEVICE=cuda
# Live Compose services default to TensorRT. Uncomment for an explicit rollback.
SWIN_L_BACKEND=pytorch
SWIN_L_ALLOW_BACKEND_FALLBACK=false
SWIN_L_BASE_IMAGE=cobiz:jetson-swin-l-l4t-r36.5.0
SWIN_L_TORCHVISION_INDEX_URL=https://pypi.jetson-ai-lab.io/jp6/cu126
SWIN_L_TORCHVISION_VERSION=0.23.0
SWIN_L_TORCH_TENSORRT_VERSION=2.8.0+cu126
SWIN_L_DEBUG_IMAGE=cobiz-plugin-line-tracking-swin-l-debug
SWIN_L_MODEL_CACHE_DIR=./.cache/huggingface
SWIN_L_PREPARED_CHECKPOINT_DIR=./models/swin-l-checkpoint
SWIN_L_ENGINE_DIR=./models
SWIN_L_TRT_ENGINE=/models/swin-l-224x384-fp16.plan
SWIN_L_TRT_MANIFEST=/models/swin-l-224x384-fp16.plan.json
# Build artifacts explicitly with the engine services before running the robot.
SWIN_L_TRT_AUTO_BUILD=false
# Limit CPU thread pools shared with camera, DDS, and other robot services.
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
# Offline test-swin-l mounts. Pre-create these directories as the host user.
# Export SWIN_L_TEST_UID=$(id -u) and SWIN_L_TEST_GID=$(id -g) before Compose.
# Use a separate writable cache from the root-owned live debug cache.
SWIN_L_ROSBAG_DIR=./rosbags
SWIN_L_TEST_RESULTS_DIR=./rosbag-results/swin-l-tests
SWIN_L_TEST_CACHE_DIR=./.cache/huggingface-tests
SWIN_L_EVALUATION_HEIGHT=360
SWIN_L_EVALUATION_WIDTH=640
# Live Jetson camera; offline MCAP tools keep their own res_360p default.
SWIN_L_IMAGE_TOPIC=/a2/front_camera/res_720p/image_raw

# Livox MID360 measured mounting. Blank CameraInfo follows the image namespace.
# Transform matrices are target-from-source 4x4, row-major, comma-separated.
# Leave matrices blank to use timestamped TF. Never insert an assumed identity
# transform: the tilted livox_frame axes are not base_link axes.
# Recreate the Compose service after changing this value; no rebuild is needed.
SWIN_L_LIDAR_TOPIC=/livox/lidar
SWIN_L_LIDAR_IMU_TOPIC=/livox/imu
SWIN_L_CAMERA_INFO_TOPIC=
SWIN_L_LIDAR_FRAME_ID=livox_frame
# Measured A2 MID360 + A2 front camera mount from teamgrit_a2_livox.yaml.
# The Unitree JT128 vertical profile does NOT apply to Livox.
SWIN_L_LIDAR_CALIBRATION_PROFILE=livox-a2-front
SWIN_L_LIDAR_TO_BASE_TRANSFORM=
SWIN_L_BASE_TO_CAMERA_TRANSFORM=
SWIN_L_LOCAL_PATH_TOPIC=/line_tracking/swin_l/local_path
SWIN_L_METRICS_TOPIC=/line_tracking/swin_l/metrics
SWIN_L_PATH_FRAME_ID=base_link
SWIN_L_INPUT_RELIABILITY=best_effort

# Run apriltag_ros inside the line-tracking container, even while tasks are idle.
# Disable this when another detector already publishes the chosen topic.
SWIN_L_APRILTAG_DETECTOR_ENABLED=true
# Enable only for standalone debugging without the actual-activate detector.
SWIN_L_DEBUG_APRILTAG_DETECTOR_ENABLED=false
# Blank uses SWIN_L_IMAGE_TOPIC and the matching namespace's camera_info.
SWIN_L_APRILTAG_IMAGE_TOPIC=
SWIN_L_APRILTAG_CAMERA_INFO_TOPIC=
SWIN_L_APRILTAG_DETECTIONS_TOPIC=/detections
SWIN_L_APRILTAG_FAMILY=36h11
SWIN_L_APRILTAG_THREADS=2
SWIN_L_APRILTAG_DECIMATE=2.0
SWIN_L_APRILTAG_MAX_HAMMING=0
SWIN_L_APRILTAG_MAX_HZ=6.0
SWIN_L_APRILTAG_MAX_AGE_SEC=1.0
SWIN_L_APRILTAG_CONFIRM_WINDOW_SEC=1.0
SWIN_L_APRILTAG_CONFIRM_MIN_HITS=3
# Stop line tracking only for tags tag_approach can take over:
# camera-to-tag range <= MAX_RANGE_M (0 disables), decision margin, id list.
SWIN_L_APRILTAG_MAX_RANGE_M=3.0
SWIN_L_APRILTAG_MIN_DECISION_MARGIN=15
SWIN_L_APRILTAG_ALLOWED_IDS=0-30
SWIN_L_APRILTAG_TAG_SIZE_M=0.167
LINE_TRACKING_MAX_FORWARD_MPS=0.50
# Visual path loss: retain forward speed, use zero yaw, stop on the third failure.
# Sensor faults continue using the existing command-hold policy.
LINE_TRACKING_PATH_LOSS_RECOVERY_ENABLED=true
# Allowed path target bearing, not yaw rate. Beyond yaw saturation, forward
# speed scales down with increasing heading demand; yaw remains capped at 0.18 rad/s.
LINE_TRACKING_MAX_TARGET_HEADING_DEG=60.0
# Automatic stops: true enables the named condition; false disables it.
# All default to false. Explicit cancellation, conversion/inference/publish
# errors, shutdown stops, input validation and speed limits remain mandatory.
# Left/right fork confirmation/loss guards also stop independently when enabled.
# Enabled obstacle avoidance stops independently on sensor/path loss, unknown
# swept space or blocked motion. Legacy stop switches cannot bypass it.
LINE_TRACKING_STOP_ON_CAMERA_STALE=false
LINE_TRACKING_STOP_ON_INFERENCE_STALE=false
LINE_TRACKING_STOP_ON_CAMERA_TIMESTAMP_INVALID=false
# PATH_UNAVAILABLE=true stops immediately. PATH_LOSS_LIMIT=true stops on the
# 5th consecutive unavailable inference even if the immediate stop is disabled.
# With both false, hold this task's last valid yaw AND forward speed without
# a loss-count limit. No previous command means wait at zero; never invent one.
# Command retention applies only with LINE_TRACKING_AVOIDANCE_ENABLED=false.
LINE_TRACKING_STOP_ON_PATH_UNAVAILABLE=false
LINE_TRACKING_STOP_ON_PATH_LOSS_LIMIT=false
LINE_TRACKING_STOP_ON_LOW_CONFIDENCE=false
LINE_TRACKING_STOP_ON_LATERAL_TARGET=false
LINE_TRACKING_STOP_ON_APRILTAG=false
LINE_TRACKING_STOP_ON_STARTUP_HOLD=false
LINE_TRACKING_STOP_ON_STARTUP_UNREADY=false
LINE_TRACKING_STOP_ON_UNSAFE_TIMEOUT=false
LINE_TRACKING_STOP_ON_TASK_TIMEOUT=false
LINE_TRACKING_TASK_EVENT_TOPIC=/task_event
LINE_TRACKING_TASK_STATE_TOPIC=/task_state
LINE_TRACKING_DEFAULT_DURATION_SEC=500
LINE_TRACKING_MAX_DURATION_SEC=10000
LINE_TRACKING_UNSAFE_TIMEOUT_SEC=2

# Geometry must be recalibrated after confirming the camera pose.  The bag has
# CameraInfo intrinsics but no camera-to-base extrinsic transform.
SWIN_L_NEAR_DISTANCE_M=3.0
SWIN_L_FAR_DISTANCE_M=8.0
SWIN_L_GROUND_HALF_WIDTH_M=4.0
SWIN_L_SEARCH_HALF_WIDTH_M=3.5
# Bottom width 84%, top width 24%, height 55% (top at image y=45%).
SWIN_L_ROI_POLYGON=0.08,1.00,0.92,1.00,0.62,0.45,0.38,0.45
SWIN_L_PATH_POINTS=20
SWIN_L_PATH_DURATION_SEC=1.50
# true: bypass the path valid-ratio gate and temporal smoothing.
# Live inference always observes SWIN_L_INFERENCE_HZ, including in this mode.
# All LINE_TRACKING_STOP_ON_* checks are independent of this extraction mode.
# In particular, STOP_ON_LOW_CONFIDENCE=true still applies the 0.49 threshold.
# The camera-only controller uses the nearest endpoint of short paths.
# Enabled avoidance adds its own reference-path age limit.
SWIN_L_UNRESTRICTED_PATH_MODE=true
# left/right prefer that arm of connected, confirmed forks, not road edges.
# right is the default; center retains legacy extraction. Dimensions use the configured BEV.
SWIN_L_BRANCH_PREFERENCE=right
SWIN_L_BRANCH_MIN_WIDTH_M=0.60
SWIN_L_BRANCH_MARGIN_M=0.10
SWIN_L_BRANCH_CONFIRM_FRAMES=2
SWIN_L_BRANCH_HOLD_SEC=1.50
# task-drive keeps the model loaded but only infers during an accepted task.
# ros2 debug mode keeps inferring without a task. This caps active inference.
SWIN_L_INFERENCE_HZ=4.0
SWIN_L_OUTPUT_HZ=10.0
SWIN_L_SMOOTHING_TIME_CONSTANT_SEC=0.80
SWIN_L_MAX_LATERAL_UPDATE_M=0.35
SWIN_L_PATH_HOLD_SEC=0.90

TEAMGRIT_DDS_DIR=/opt/ros/teamgrit/dds

# Livox obstacle sector: base_link z +/- 0.20 m, horizontal radius 1.5 m, front 190 deg.
# Footprint/self-mask dimensions must match the deployed A2 and gait.
# No odometry: 10 Hz LiDAR targets, 20 Hz smooth commands in base_link.
# right/left are body-relative; only the latest camera reference is used.
LINE_TRACKING_AVOIDANCE_ENABLED=true
LIDAR_OBSTACLE_HEIGHT_REFERENCE=base_link
LIDAR_OBSTACLE_MIN_HEIGHT_M=-0.2
LIDAR_OBSTACLE_MAX_HEIGHT_M=0.2
# Detection sector about base_link: +x forward, horizontal distance, ±95 degrees.
LIDAR_OBSTACLE_HORIZONTAL_RANGE_M=1.5
LIDAR_OBSTACLE_FOV_DEG=190.0
LIDAR_OBSTACLE_MAX_AGE_SEC=0.3
LIDAR_OBSTACLE_IMU_ACCEL_UNIT=auto
# Grid storage/footprint-check bounds; the detection sector above clips observations.
LIDAR_OBSTACLE_FORWARD_M=6.0
LIDAR_OBSTACLE_REAR_M=1.0
LIDAR_OBSTACLE_HALF_WIDTH_M=2.0
LIDAR_OBSTACLE_RESOLUTION_M=0.1
LIDAR_OBSTACLE_FRONT_M=0.5
LIDAR_OBSTACLE_BACK_M=0.45
LIDAR_OBSTACLE_ROBOT_HALF_WIDTH_M=0.3
LIDAR_OBSTACLE_MARGIN_M=0.15
LIDAR_OBSTACLE_SELF_FRONT_M=0.3
LIDAR_OBSTACLE_SELF_BACK_M=0.3
LIDAR_OBSTACLE_SELF_HALF_WIDTH_M=0.16
LIDAR_OBSTACLE_LIDAR_TO_GROUND_M=0.4
LIDAR_OBSTACLE_INFLATION_M=2.0
LINE_TRACKING_AVOIDANCE_PREFERENCE=right
LINE_TRACKING_AVOIDANCE_CONTROL_HZ=20.0
LINE_TRACKING_AVOIDANCE_MAX_LATERAL_MPS=0.15
LINE_TRACKING_AVOIDANCE_MAX_FORWARD_MPS=0.2
LINE_TRACKING_AVOIDANCE_MAX_ACCEL_MPS2=0.3
LINE_TRACKING_AVOIDANCE_PREDICTION_SEC=3.0
LINE_TRACKING_AVOIDANCE_MAX_PATH_AGE_SEC=2.0
LINE_TRACKING_AVOIDANCE_RETURN_GAIN=0.5
LINE_TRACKING_AVOIDANCE_BRAKE_MPS2=0.5
LINE_TRACKING_AVOIDANCE_UNTRACKED_CLOSING_MPS=1.0
LINE_TRACKING_AVOIDANCE_SIDE_HOLD_SEC=1.0
