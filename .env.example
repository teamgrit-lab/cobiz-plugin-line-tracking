ROS_DOMAIN_ID=0
IMAGE_TOPIC=/a2/front_camera/image_raw
JOY_TOPIC=/a2_control
# CONTROL_TOPIC is an alias for JOY_TOPIC; set only one of them.
# CONTROL_TOPIC=/my_robot/control
DEBUG_IMAGE_TOPIC=/line_tracking/debug_image
MASK_TOPIC=/line_tracking/mask
CONFIDENCE_TOPIC=/line_tracking/confidence
INPUT_RELIABILITY=best_effort

# Select the model exported for the camera stream. These profile model files
# are local deployment artifacts; see models/README.md.
CAMERA_PROFILE=360p
SEGMENTATION_INPUT_WIDTH=640
SEGMENTATION_INPUT_HEIGHT=384
SEGMENTATION_MODEL_PATH=/models/yolop-360-640.onnx

# Safe inspection mode: publishes masks, overlay, centerline Path and metrics.
TEST_MODE=false
PUBLISH_CONTROL_IN_TEST_MODE=false
TEST_DEBUG_IMAGE_TOPIC=/line_tracking/test/debug_image
TEST_ROAD_MASK_TOPIC=/line_tracking/test/road_mask
TEST_RAW_LINE_MASK_TOPIC=/line_tracking/test/raw_line_mask
TEST_LINE_MASK_TOPIC=/line_tracking/test/line_mask
TEST_BIRDSEYE_MASK_TOPIC=/line_tracking/test/birdseye_mask
TEST_CENTERLINE_TOPIC=/line_tracking/test/centerline
TEST_METRICS_TOPIC=/line_tracking/test/metrics
CENTERLINE_FRAME_ID=base_link

# Swin-L sidewalk-center local-path debug process.  These defaults match the
# attached rosbag: RGB8 640x360 at 20Hz and Hesai PointCloud2 at 10Hz.
SWIN_L_PROFILE=swin-l-best-so-far
SWIN_L_MODEL_ID=
SWIN_L_MODEL_REVISION=
# For the Jetson debug container use cuda. Build this local base image once on
# the Jetson host with jetson-containers before starting Compose:
# PYTORCH_VERSION=2.8 CUDA_VERSION=12.6 jetson-containers build \
#   --base=cobiz:jetson --name=cobiz:jetson-swin-l \
#   --skip-packages=ffmpeg,opencv,ros pytorch:2.8
SWIN_L_DEVICE=cuda
SWIN_L_BASE_IMAGE=cobiz:jetson-swin-l-l4t-r36.5.0
SWIN_L_TORCHVISION_INDEX_URL=https://pypi.jetson-ai-lab.io/jp6/cu126
SWIN_L_TORCHVISION_VERSION=0.23.0
SWIN_L_DEBUG_IMAGE=cobiz-plugin-line-tracking-swin-l-debug
SWIN_L_MODEL_CACHE_DIR=./.cache/huggingface
# Offline test-swin-l mounts. Pre-create these directories as the host user.
# Export SWIN_L_TEST_UID=$(id -u) and SWIN_L_TEST_GID=$(id -g) before Compose.
# Use a separate writable cache from the root-owned live debug cache.
SWIN_L_ROSBAG_DIR=./rosbags
SWIN_L_TEST_RESULTS_DIR=./rosbag-results/swin-l-tests
SWIN_L_TEST_CACHE_DIR=./.cache/huggingface-tests
SWIN_L_EVALUATION_HEIGHT=360
SWIN_L_EVALUATION_WIDTH=640
SWIN_L_IMAGE_TOPIC=/a2/front_camera/res_360p/image_raw
SWIN_L_LIDAR_TOPIC=/unitree/slam_lidar/points1
SWIN_L_OVERLAY_TOPIC=/line_tracking/swin_l/overlay
SWIN_L_LOCAL_PATH_TOPIC=/line_tracking/swin_l/local_path
SWIN_L_SAFETY_STOP_TOPIC=/line_tracking/swin_l/safety_stop
SWIN_L_CLEARANCE_TOPIC=/line_tracking/swin_l/clearance_m
SWIN_L_METRICS_TOPIC=/line_tracking/swin_l/metrics
SWIN_L_PATH_FRAME_ID=base_link
SWIN_L_INPUT_RELIABILITY=best_effort

# Geometry must be recalibrated after confirming the camera pose.  The bag has
# CameraInfo intrinsics but no camera-to-base extrinsic transform.
SWIN_L_NEAR_DISTANCE_M=3.0
SWIN_L_FAR_DISTANCE_M=8.0
SWIN_L_GROUND_HALF_WIDTH_M=4.0
SWIN_L_SEARCH_HALF_WIDTH_M=3.5
SWIN_L_ROI_POLYGON=0.08,1.00,0.92,1.00,0.62,0.22,0.38,0.22
SWIN_L_PATH_POINTS=20
SWIN_L_PATH_DURATION_SEC=1.50
SWIN_L_INFERENCE_HZ=4.0
SWIN_L_OUTPUT_HZ=10.0
SWIN_L_SMOOTHING_TIME_CONSTANT_SEC=0.80
SWIN_L_MAX_LATERAL_UPDATE_M=0.35
SWIN_L_PATH_HOLD_SEC=0.90

# LiDAR safety layer.  PointCloud2 x/y are assumed aligned to base_link until
# an extrinsic transform is added and the thresholds are calibrated.
SWIN_L_OBSTACLE_DISTANCE_M=8.0
SWIN_L_STOP_DISTANCE_M=3.0
SWIN_L_CORRIDOR_HALF_WIDTH_M=0.55
SWIN_L_LIDAR_TIMEOUT_SEC=0.35
SWIN_L_LIDAR_Z_MIN_M=-0.40
SWIN_L_LIDAR_Z_MAX_M=0.80
SWIN_L_MIN_OBSTACLE_POINTS=3

TEAMGRIT_DDS_DIR=/opt/ros/teamgrit/dds
# Mount the downloaded YOLOP ONNX file from ./models into the container.
MODEL_DIR=./models
