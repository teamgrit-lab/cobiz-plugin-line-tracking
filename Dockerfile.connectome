ARG CONNECTOME_BASE_IMAGE=cobiz-plugin-line-tracking-runtime
FROM ${CONNECTOME_BASE_IMAGE}
SHELL ["/bin/bash", "-c"]
# Reuse CUDA PyTorch from the tracking image, constrain its exact versions so
# pip cannot replace it with a generic PyPI wheel on Jetson.
RUN /opt/venv/bin/python -m venv --system-site-packages /opt/connectome-venv \
    && /opt/venv/bin/python -c "import pathlib,sys; p=pathlib.Path('/opt/connectome-venv/lib')/('python'+'.'.join(map(str,sys.version_info[:2])))/'site-packages'; (p/'tracking-base.pth').write_text('\n'.join(dict.fromkeys(s for s in sys.path if s.endswith(('site-packages','dist-packages')) and pathlib.Path(s).is_dir()))+'\n')" \
    && /opt/venv/bin/python -c "import importlib.metadata as m; open('/tmp/connectome-constraints.txt','w').write('\n'.join(k+'=='+m.version(k) for k in ['torch','torchvision','numpy']))" \
    && /opt/venv/bin/python -c "import torch,json; json.dump([torch.__file__,torch.__version__,torch.version.cuda],open('/tmp/connectome-torch.json','w'))"
COPY requirements-connectome.txt /tmp/requirements-connectome.txt
# The parent image can export Jetson wheel indexes or PIP_CONSTRAINT settings.
# Only this layer's explicit CUDA-stack constraints apply to Flyvis dependencies.
RUN PIP_CONFIG_FILE=/dev/null /opt/connectome-venv/bin/python -m pip --isolated install --no-cache-dir \
        --index-url https://pypi.org/simple \
        -c /tmp/connectome-constraints.txt -r /tmp/requirements-connectome.txt \
    && MPLBACKEND=Agg /opt/connectome-venv/bin/python -c "import cv2,torch,json,flyvis,hydra,omegaconf; assert [torch.__file__,torch.__version__,torch.version.cuda]==json.load(open('/tmp/connectome-torch.json')); print('Flyvis',flyvis.__version__,'Hydra',hydra.__version__,'OmegaConf',omegaconf.__version__,'OpenCV',cv2.__version__,'CUDA',torch.version.cuda)"
ENV MPLBACKEND=Agg MPLCONFIGDIR=/tmp/connectome-matplotlib FLYVIS_ROOT_DIR=/tmp/connectome-flyvis
COPY tools /workspace/tools
COPY config/camera360-profile.json /workspace/config/camera360-profile.json
COPY docker/connectome_camera_entrypoint.sh /entrypoint-connectome-camera.sh
RUN chmod +x /entrypoint-connectome-camera.sh
ENTRYPOINT ["/opt/connectome-venv/bin/python", "/workspace/tools/connectome_server.py"]
