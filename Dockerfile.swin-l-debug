ARG SWIN_L_BASE_IMAGE=cobiz:jetson-swin-l-l4t-r36.5.0
FROM ${SWIN_L_BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

# The Jetson base supplies CUDA and the NVIDIA OpenCV runtime. Install only
# native build/ROS dependencies; the runtime has no Python, PyTorch, or
# Transformers dependency.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        libopencv-dev \
        ninja-build \
        nlohmann-json3-dev \
        ros-humble-cv-bridge \
        ros-humble-geometry-msgs \
        ros-humble-nav-msgs \
        ros-humble-rclcpp \
        ros-humble-rmw-cyclonedds-cpp \
        ros-humble-sensor-msgs \
        ros-humble-std-msgs \
        ros-humble-rosbag2-storage-mcap \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY CMakeLists.txt package.xml /workspace/
COPY include /workspace/include
COPY src /workspace/src
COPY apps /workspace/apps
COPY ros /workspace/ros
COPY docker/swin_l_debug_entrypoint.sh /entrypoint-swin-l-debug.sh

RUN source /opt/ros/humble/setup.bash \
    && cmake -S /workspace -B /workspace/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/cobiz-line-tracking \
        -DLINE_TRACKING_BUILD_ROS2=ON \
        -DLINE_TRACKING_BUILD_TESTS=OFF \
    && cmake --build /workspace/build \
    && cmake --install /workspace/build \
    && test -x /opt/cobiz-line-tracking/lib/cobiz_line_tracking/line_tracking_node \
    && chmod +x /entrypoint-swin-l-debug.sh \
    && rm -rf /workspace/build

ENTRYPOINT ["/entrypoint-swin-l-debug.sh"]
