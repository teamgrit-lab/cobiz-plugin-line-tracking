ARG SWIN_L_BASE_IMAGE=cobiz:jetson-swin-l-l4t-r36.5.0
FROM ${SWIN_L_BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/root/.cache/huggingface
SHELL ["/bin/bash", "-c"]

ARG SWIN_L_TORCHVISION_INDEX_URL=https://pypi.jetson-ai-lab.io/jp6/cu126
ARG SWIN_L_TORCHVISION_VERSION=0.23.0

# The base image is built once with jetson-containers and provides the
# Jetson-compatible PyTorch, CUDA, and ROS stack. torchvision and Transformers
# is installed below from the Jetson aarch64 index because pytorch:2.8 does
# not include it and the generic alias currently resolves to a newer release.
# Do not install torch from PyPI here: pip can select a CPU wheel or a CUDA
# build that is newer than the Jetson host driver.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3-pip \
        python3-venv \
        python3-numpy \
        python3-opencv \
        ros-humble-cv-bridge \
        ros-humble-geometry-msgs \
        ros-humble-nav-msgs \
        ros-humble-rmw-cyclonedds-cpp \
        ros-humble-sensor-msgs \
        ros-humble-std-msgs \
    && rm -rf /var/lib/apt/lists/*

# Keep ROS's system Python visible so rclpy/cv_bridge remain available while
# installing the model-side Python packages in an isolated environment.
RUN python3 -m venv --system-site-packages /opt/swin-l-venv \
    && /opt/swin-l-venv/bin/python -m pip install --no-cache-dir \
        --index-url "${SWIN_L_TORCHVISION_INDEX_URL}" \
        --no-deps \
        --only-binary=torchvision \
        "torchvision==${SWIN_L_TORCHVISION_VERSION}" \
    && /opt/swin-l-venv/bin/python -m pip install --no-cache-dir \
        "numpy>=1.26,<2" \
        "pillow>=10,<14" \
        "scipy>=1.10,<2" \
        "transformers==5.16.1" \
        "mcap==1.4.0" \
        "mcap-ros2-support==0.5.7"

# Fail during the image build if the base image did not actually provide the
# expected CUDA-enabled model stack. GPU availability itself cannot be tested
# in a Docker build because BuildKit is not given the Jetson GPU device.
RUN /opt/swin-l-venv/bin/python -c \
    'import torch, torchvision, transformers; \
     cuda = torch.version.cuda; \
     assert cuda and cuda.startswith("12.6"), f"expected CUDA 12.6 PyTorch, got {cuda!r}"; \
     print(f"[swin-l-debug] base torch={torch.__version__} torchvision={torchvision.__version__} cuda={cuda} transformers={transformers.__version__}")'

ENV PATH=/opt/swin-l-venv/bin:${PATH}
WORKDIR /workspace
COPY tools /workspace/tools
COPY docker/swin_l_debug_entrypoint.sh /entrypoint-swin-l-debug.sh
RUN chmod +x /entrypoint-swin-l-debug.sh

ENTRYPOINT ["/entrypoint-swin-l-debug.sh"]
