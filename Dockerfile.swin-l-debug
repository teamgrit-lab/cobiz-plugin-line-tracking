ARG SWIN_L_BASE_IMAGE=cobiz:jetson-swin-l-l4t-r36.5.0
FROM ${SWIN_L_BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/root/.cache/huggingface
SHELL ["/bin/bash", "-c"]

ARG SWIN_L_TORCHVISION_INDEX_URL=https://pypi.jetson-ai-lab.io/jp6/cu126
ARG SWIN_L_TORCHVISION_VERSION=0.23.0
ARG SWIN_L_TORCH_TENSORRT_VERSION=2.8.0+cu126

# The base image is built once with jetson-containers and provides the
# Jetson-compatible PyTorch, CUDA, and ROS stack. torchvision and Transformers
# is installed below from the Jetson aarch64 index because pytorch:2.8 does
# not include it and the generic alias currently resolves to a newer release.
# TensorRT's Python binding is installed from the JetPack apt repository below.
# The matching Torch-TensorRT wheel comes from the same Jetson CUDA 12.6 index
# as torchvision.
# Do not install torch from PyPI here: pip can select a CPU wheel or a CUDA
# build that is newer than the Jetson host driver.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3-pip \
        python3-colcon-common-extensions \
        python3-numpy \
        python3-opencv \
        python3-libnvinfer \
        ros-humble-cv-bridge \
        ros-humble-geometry-msgs \
        ros-humble-nav-msgs \
        ros-humble-rmw-cyclonedds-cpp \
        ros-humble-rosidl-default-generators \
        ros-humble-rosidl-generator-dds-idl \
        ros-humble-sensor-msgs \
        ros-humble-std-msgs \
    && rm -rf /var/lib/apt/lists/*

# python3-opencv installs cv2 into Debian's dist-packages directory, while
# the base image runs its /opt/venv interpreter. Add that directory through a
# .pth file so cv2 is visible without putting the system NumPy ahead of the
# model environment's NumPy<2.
RUN /opt/venv/bin/python -c \
    "import site; from pathlib import Path; Path(site.getsitepackages()[0], 'jetson-system-dist-packages.pth').write_text('/usr/lib/python3/dist-packages\\n/usr/lib/python3.10/dist-packages\\n')"

# Reuse the Python environment from the Jetson base image. PyTorch is installed
# there by jetson-containers under /opt/venv; a separate venv would not see it,
# even when created with --system-site-packages.
RUN /opt/venv/bin/python -m pip install --no-cache-dir \
        --index-url "${SWIN_L_TORCHVISION_INDEX_URL}" \
        --no-deps \
        --only-binary=torchvision \
        "torchvision==${SWIN_L_TORCHVISION_VERSION}" \
    && /opt/venv/bin/python -m pip install --no-cache-dir \
        --index-url "${SWIN_L_TORCHVISION_INDEX_URL}" \
        --no-deps \
        --only-binary=:all: \
        "torch-tensorrt==${SWIN_L_TORCH_TENSORRT_VERSION}" \
    && /opt/venv/bin/python -m pip install --no-cache-dir \
        "numpy>=1.26,<2" \
        "pillow>=10,<14" \
        "scipy>=1.10,<2" \
        "transformers==5.16.1" \
        "mcap==1.4.0" \
        "mcap-ros2-support==0.5.7"

# Fail during the image build if the expected Python modules are absent.
# Importing TensorRT is deliberately deferred to container startup: on Jetson
# its extension links libnvos.so, which the NVIDIA runtime injects but plain
# BuildKit does not expose.
RUN /opt/venv/bin/python -c \
    'import cv2, importlib.util, torch, torchvision, transformers; \
     cuda = torch.version.cuda; \
     assert cuda and cuda.startswith("12.6"), f"expected CUDA 12.6 PyTorch, got {cuda!r}"; \
     assert importlib.util.find_spec("tensorrt") is not None, "TensorRT Python bindings are missing"; \
     assert importlib.util.find_spec("torch_tensorrt") is not None, "Torch-TensorRT is missing"; \
     print(f"[swin-l-debug] base torch={torch.__version__} torchvision={torchvision.__version__} cuda={cuda} tensorrt=present torch_tensorrt=present transformers={transformers.__version__} opencv={cv2.__version__}")'

WORKDIR /unitree_ws
COPY third_party/unitree_msgs/unitree_api /unitree_ws/src/unitree_api
COPY third_party/apriltag_msgs/apriltag_msgs /unitree_ws/src/apriltag_msgs
RUN source /opt/ros/humble/setup.bash \
    && colcon build --merge-install --packages-select unitree_api apriltag_msgs \
    && source /unitree_ws/install/setup.bash \
    && /opt/venv/bin/python -c \
       'from unitree_api.msg import Request; from apriltag_msgs.msg import AprilTagDetectionArray; request = Request(); request.header.identity.api_id = 1008; detections = AprilTagDetectionArray(); print("[swin-l-debug] ROS interfaces ready")'

ENV PATH=/opt/venv/bin:${PATH}
WORKDIR /workspace
COPY tools /workspace/tools
COPY docker/swin_l_debug_entrypoint.sh /entrypoint-swin-l-debug.sh
RUN chmod +x /entrypoint-swin-l-debug.sh

ENTRYPOINT ["/entrypoint-swin-l-debug.sh"]
