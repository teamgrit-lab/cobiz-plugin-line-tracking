ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
SHELL ["/bin/bash", "-c"]

# cobiz:jetson already provides Ubuntu 22.04/Python 3.10, CUDA 12.6 and the
# ROS 2 Humble core.  This layer completes the runtime dependencies that are
# not present in that image.  PyTorch, torchvision and Transformers are
# installed by jetson-containers before this Dockerfile is built.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3-pip \
        python3-venv \
        python3-numpy \
        python3-opencv \
        ros-humble-cv-bridge \
        ros-humble-geometry-msgs \
        ros-humble-nav-msgs \
        ros-humble-sensor-msgs \
        ros-humble-std-msgs \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Fail during the image build, instead of waiting for the debug container to
# restart, when the Jetson-specific model or ROS bindings are not present.
RUN source /opt/ros/humble/setup.bash \
    && python3 - <<'PY'
import torch
import torchvision
import transformers
import rclpy
import cv_bridge

print(f"torch={torch.__version__}")
print(f"torchvision={torchvision.__version__}")
print(f"transformers={transformers.__version__}")
print(f"rclpy={rclpy.__file__}")
print(f"cv_bridge={cv_bridge.__file__}")
PY
